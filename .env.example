# Server / deploy (never commit real values)
PRIVATE_KEY=
CIVORA_TREASURY=

# GMI Cloud underwriter
GMI_API_KEY=
GMI_MODEL=deepseek-ai/DeepSeek-V4-Flash
GMI_BASE_URL=https://api.gmi-serving.com/v1

# Per-IP model-call budget for the public /api/underwrite and /api/monitor routes
AI_RATE_LIMIT_PER_MIN=15

# Optional: require `X-Civora-Secret: <value>` on /api/underwrite and /api/monitor.
# Recommended for production so the paid model key cannot be spent by anonymous callers.
AI_ROUTE_SECRET=

# Hosted report persistence (Vercel Blob, required for production)
BLOB_READ_WRITE_TOKEN=

# Local report directory when BLOB_READ_WRITE_TOKEN is unset (default: apps/web/data/reports)
REPORT_STORE_DIR=

# Frontend (public)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_CHAIN_ID=677
